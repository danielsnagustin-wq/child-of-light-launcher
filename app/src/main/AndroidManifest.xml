<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Child of Light Launcher.
      Sin permisos de red ni de ubicación. Todo el trabajo es local:
      importar la copia del usuario (SAF), guardarla en el almacenamiento
      privado de la app y escribir config.yml para Vita3K.
      No se incluye juego, firmware ni claves.
    -->
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!-- Pedir exención de optimización de batería (la concede el usuario) y
         cerrar apps en segundo plano antes de jugar (best-effort). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Copia de .pkg a Descargas en API 28 (en API 29+ se usa MediaStore, sin permiso). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Visibilidad de paquetes (Android 11+): sin <queries>, el sistema
         oculta Vita3K y getLaunchIntentForPackage/getPackageInfo devuelven
         null aunque esté instalado ("Vita3K no instalado" falso y JUGAR
         bloqueado). Solo se declara Vita3K, nada más. -->
    <queries>
        <package android:name="org.vita3k.emulator" />
    </queries>

    <!-- RAM ≤ 4 GB (auditoría 2026-11-07): largeHeap NO se activa.
         largeHeap solo sube el límite del heap JAVA; la memoria del
         núcleo embebido es NATIVA (mmap, fuera del heap Java), así que
         no le ayudaría y sí competiría con el sistema y con el propio
         núcleo por los 4 GB (más GC, más riesgo de que el sistema
         mate el proceso). El heap Java del launcher es pequeño
         (Compose + listas de KBs: 27 trofeos, índice de sesiones);
         el límite por defecto basta. Lo que sí ahorra RAM aquí es el
         perfil conservador de DeviceMemory (1x, Double Buffer) y
         copiar archivos grandes por streaming con buffer fijo. -->
    <!-- R2-P2-38: allowBackup="false": los datos privados (sesiones,
         ajustes, work.bin, saves) NO salen del teléfono con el backup
         automático de Google, ni se resucitan sesiones borradas al
         restaurar en otro teléfono. El launcher ya tiene su propia
         exportación (sesiones, saves, logros, copia de ajustes). -->
    <application
        android:allowBackup="false"
        android:largeHeap="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChildOfLightLauncher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Etapa 2: Activity SDL del núcleo embebido. Solo la abre el
             launcher (exported=false) cuando el núcleo está presente;
             sin núcleo no se lanza nunca. launchMode y configChanges
             como el Emulator de Vita3K upstream. -->
        <activity
            android:name=".core.EmbeddedGameActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.ChildOfLightLauncher" />

        <!-- Menú de pausa propio (Compose): Activity transparente
             encima del juego. Solo la abre EmbeddedGameActivity (con
             atrás o con el botón guía); nunca se lanza desde el
             launcher. El juego se pausa por fondo mientras está
             abierta y se reanuda al elegir Continuar. -->
        <activity
            android:name=".ui.PauseMenuActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
