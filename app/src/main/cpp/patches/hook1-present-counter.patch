+// Ronda 0.2.66, gancho nº 1 de instrumentación Fase P (INST-P0-3 / R-P1-1):
+// contador de frames PRESENTADOS por el swapchain + timestamp del último.
+// presentKHR es el único punto donde un frame emulado se convierte en
+// frame visible; el FPS del núcleo (EmuEnvState::fps) solo cuenta frames
+// emulados. El puente del launcher lee estos dos valores por JNI
+// (runtime_bridge.cpp: nativeGetPresentedFrameCount /
+// nativeGetLastPresentTimeNs) y calcula presents/s. Reloj monotónico:
+// solo importan los deltas, no la época. No se usa get_emuenv(): los
+// contadores pertenecen al swapchain, no al EmuEnvState, y tocar su
+// layout por un contador sería más invasivo que este par de accesores.
+static std::atomic<uint64_t> presented_frame_count{ 0 };
+static std::atomic<uint64_t> last_present_time_ns{ 0 };
+
+extern "C" uint64_t vita3k_presented_frame_count() {
+    return presented_frame_count.load(std::memory_order_relaxed);
+}
+
+extern "C" uint64_t vita3k_last_present_time_ns() {
+    return last_present_time_ns.load(std::memory_order_relaxed);
+}
+
 namespace renderer::vulkan {
 
